{
  "_projectInfo": {
    "file": "export/processors/mach3.json",
    "description": "Post-processor setup: Mach3",
    "author": "Eltryus - Ricardo Marques",
    "see": "https://github.com/RicardoJCMarques/EasyCAM5000",
    "license": "AGPL-3.0-or-later",
    "copyright": "Copyright (C) 2025-2026 Eltryus - Ricardo Marques"
  },
  "meta": { "kind": "setup" },
  "id": "mach3",
  "label": "Mach3",
  "logic": "rs274",
  "maturity": "experimental",
  "flags": {
    "fileExtension": ".tap",
    "commentStyle": "parenthesis",
    "supportsComments": true,
    "supportsUnits": true,
    "supportsCoolant": true,
    "supportsLineNumbers": true,
    "lineNumberMax": 99999,
    "modalCommands": true,
    "coordinateDecimals": 4,
    "rotaryDecimals": 4,
    "feedDecimals": 1,
    "spindleDecimals": 0,
    "maxSpindleSpeed": 24000,
    "spindle": { "on": "M3", "off": "M5", "scale": null },
    "dwellUnit": "s",
    "dwellWord": "P",
    "supportsArcCommands": true,
    "arcFormat": "IJ",
    "supportsCannedCycles": true,
    "supportsToolChange": true,
    "useM6": true,
    "initialToolUsesM6": false,
    "emitsInitialTool": true,
    "pauseAfterToolChange": true,
    "toolLengthComp": ["table", "none"],
    "supportsAbsoluteZ": false,
    "rotary": {
      "routes": ["a-word", "wrapped-linear"],
      "axisWords": ["A", "B"],
      "inverseTime": true,
      "maxInverseTime": 9999.99,
      "continuous": true
    }
  },
  "defaults": {
    "startCode": "",
    "endCode": "M5\nG0 X0Y0\nM30",
    "toolLengthCompMode": "table",
    "rotaryRoute": "a-word",
    "indexDwell": 0.3,
    "lineNumbers": false,
    "lineNumberStep": 10
  },
  "locks": {},
  "_notes": {
    "rotary": "Drives A/B/C and supports G93 inverse time. DRAFT - verify G93 on your build, and confirm the axis is configured ROTATIONAL (degrees) rather than linear, or 'a-word' degrees will be read as millimetres. indexDwell drives anything; Machine Settings overrides it."
  }
}