# 404 page
ErrorDocument 404 /404.html

# Directory handling & prevent MultiViews conflicts
DirectoryIndex index.html
Options -MultiViews -Indexes

RewriteEngine On

# Host guard: Redirect requests arriving via www.eltryus.design/cam/... to canonical subdomain
RewriteCond %{HTTP_HOST} !^cam\.eltryus\.design$ [NC]
RewriteRule ^(.*)$ https://cam.eltryus.design/$1 [R=301,L]

# FORCE HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ENSURE DIRECTORY SLASHES
DirectorySlash On

# DIRECT SINGLE-HOP 301s FOR LEGACY PATHS
RewriteRule ^app(\.html)?/?$           /easytrace5000/ [R=301,L]
RewriteRule ^cnc(\.html)?/?$           /easytrace5000/doc/cnc [R=301,L]
RewriteRule ^laser(\.html)?/?$         /easytrace5000/doc/laser [R=301,L]
RewriteRule ^doc/?$                    /easytrace5000/doc/ [R=301,L]
RewriteRule ^doc/([^/.]+?)(\.html)?/?$ /easytrace5000/doc/$1 [R=301,L]

# CLEAN INDEX.HTML -> TRAILING SLASH /
RewriteCond %{THE_REQUEST} \s/+([^\s?]*/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# .HTML EXTENSION (Single-hop redirect for direct hits, query-safe)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# INTERNAL REWRITE (Extensionless URL -> .html file)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# MIME TYPES
AddDefaultCharset UTF-8
AddType text/javascript .js
AddType application/wasm .wasm
AddType application/json .json
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType image/x-icon .ico
AddType font/woff .woff
AddType font/woff2 .woff2

# COMPRESSION
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/wasm image/svg+xml

# SECURITY HEADERS & SUBDOMAIN ISOLATION
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"

  # HTML, code, and language definitions: revalidate immediately
  <FilesMatch "\.(html|css|js|mjs|json|webmanifest|wasm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Static assets and immutable binaries
  <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>