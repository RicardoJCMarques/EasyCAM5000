      "unit": "mm",
      "stage": "geometry",
      "category": "holding",
      "operationTypes": "rotary",
      "conditional": "rotaryKinematics:indexed",
      "default": null,
      "nullable": true,
      "min": 0,
      "max": 10,
      "step": 0.05
    },
    "rotaryMinRadius": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "holding",
