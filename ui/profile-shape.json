      "step": 0.1
    },
    "indexedDepth": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "depth",
      "operationTypes": "rotary",
      "conditional": "rotaryKinematics:indexed",
      "default": null,
      "nullable": true,
      "min": 0.1,
      "max": 150,
      "step": 0.1
    },
    "indexedAxisOvercut": {
