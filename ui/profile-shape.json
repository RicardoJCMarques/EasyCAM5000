{
  "_projectInfo": {
    "file": "ui/profile-shape.json",
    "description": "EasyShape5000 profile",
    "author": "Eltryus - Ricardo Marques",
    "see": "https://github.com/RicardoJCMarques/EasyCAM5000",
    "license": "AGPL-3.0-or-later",
    "copyright": "Copyright (C) 2025-2026 Eltryus - Ricardo Marques"
  },
  "meta": {
    "app": "EasyShape5000",
    "version": "1.2"
  },
  "clipper2scale": 1000,
  "chains": {
    "2.5d": {
      "stages": ["geometry", "strategy", "machine", "output"],
      "artifacts": ["offsets", "preview", "toolpath"]
    },
    "3d": {
      "stages": ["geometry", "machine", "output"],
      "artifacts": ["offsets", "toolpath"]
    }
  },
  "auxHandlers": {
    "rotary-indexed": "ShapeIndexedHandler"
  },
  "operations": {
    "profile": {
      "handler": "ShapeProfileHandler",
      "icon": "icon-op-profile",
      "extensions": [".svg"],
      "defaultTool": "em_3.175mm_flat",
      "viz": true,
      "machineClasses": { "router": "2.5d" }
    },
    "pocket": {
      "handler": "ShapePocketHandler",
      "icon": "icon-op-pocket",
      "extensions": [".svg"],
      "defaultTool": "em_3.175mm_flat",
      "viz": true,
      "machineClasses": { "router": "2.5d" }
    },
    "drill": {
      "handler": "DrillHandler",
      "icon": "icon-op-drilling",
      "extensions": [".svg"],
      "defaultTool": "drill_3.175mm",
      "viz": true,
      "machineClasses": { "router": "2.5d" }
    },
    "engrave": {
      "handler": "ShapeEngraveHandler",
      "icon": "icon-op-engrave",
      "extensions": [".svg"],
      "defaultTool": "vbit_10deg_0.1mm",
      "toolSizing": "effective",
      "defaults": { "cutDepth": 0.1, "multiDepth": false },
      "viz": true,
      "machineClasses": { "router": "2.5d" }
    },
    "vcarve": {
      "handler": "ShapeVCarveHandler",
      "icon": "icon-op-vcarve",
      "extensions": [".svg"],
      "defaultTool": "vbit_90deg_0.3mm",
      "viz": true,
      "machineClasses": { "router": "3d" }
    },
    "relief": {
      "handler": "ShapeReliefHandler",
      "icon": "icon-op-relief",
      "extensions": [".stl"],
      "defaultTool": "em_3.175mm_ball",
      "viz": true,
      "machineClasses": { "router": "3d" }
    },
    "rotary": {
      "handler": "ShapeRotaryHandler",
      "icon": "icon-op-rotary",
      "extensions": [".stl"],
      "defaultTool": "em_3.175mm_ball",
      "viz": true,
      "machineClasses": { "router": "3d" }
    },
    "pattern": {
      "handler": "ShapePatternHandler",
      "optionalHandler": true,
      "tab": false,
      "extensions": [".svg"],
      "viz": true,
      "machineClasses": { "router": "2.5d" }
    },
    "unassigned": {
      "virtual": true,
      "tab": false,
      "extensions": [".svg", ".stl"],
      "viz": true
    }
  },
  "examples": {
    "mesa": {
      "files": { "svg": "../examples/temp/mesa.svg" }
    },
    "vcarve-sign": {
      "files": { "svg": "../examples/temp/leafheart.svg" }
    },
    "relief-tile": {
      "files": { "stl": "../examples/temp/setubal.stl" }
    },
    "rotary-pawn": {
      "files": { "stl": "../examples/temp/viking.stl" }
    }
  },
  "ui": {
    "exportOrder": ["drill"],
    "categories": [
      "post",
      "stock",
      "heights",
      "rotary",
      "tool",
      "blank",
      "bounds",
      "holding",
      "offset",
      "depth",
      "passes",
      "roughing",
      "finishing",
      "tabs",
      "drill",
      "pattern",
      "quality",
      "feeds",
      "toolpath",
      "general"
    ],
    "artifacts": {
      "offsets": { "icon": "icon-stage-offsets" },
      "preview": { "icon": "icon-stage-preview" },
      "toolpath": { "icon": "icon-stage-toolpath" }
    }
  },
  "machineParameters": {
    "machine.stock.width": { "default": 600 },
    "machine.stock.length": { "default": 400 },
    "machine.stock.thickness": { "default": 18 },
    "machine.stock.material": { "default": "plywood" },
    "machine.stock.zeroReference": { "default": "bed" },
    "machine.heights.safeZ": { "default": 25.0 },
    "machine.heights.travelZ": { "default": 10.0 },
    "machine.heights.feedHeight": { "default": 5.0 },
    "machine.heights.maxSafeDepth": { "default": -50.0 },
    "machine.speeds.rapidFeed": { "default": 2000 },
    "machine.speeds.maxFeed": { "default": 5000 },
    "laser.activeProfile": null,
    "laser.spotSize": null,
    "laser.exportFormat": null,
    "laser.exportDPI": null,
    "laser.exportPadding": null
  },
  "parameters": {
    "_comment_tools": "═══ TOOL SELECTION (geometry stage) ═══",
    "tool": {
      "type": "select",
      "stage": "geometry",
      "category": "tool",
      "operationTypes": ["profile", "pocket", "drill", "engrave", "vcarve", "relief", "rotary"],
      "conditional": "!drillMultiTool"
    },
    "toolNumber": {
      "type": "number",
      "stage": "geometry",
      "category": "tool",
      "operationTypes": ["profile", "pocket", "drill", "engrave", "vcarve", "relief", "rotary"],
      "conditional": "!drillMultiTool",
      "default": 1,
      "min": 1,
      "max": 99,
      "step": 1,
      "invalidates": false
    },
    "toolDiameter": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "tool",
      "conditional": "!drillMultiTool",
      "operationTypes": ["profile", "pocket", "drill", "engrave", "vcarve", "relief", "rotary"],
      "min": 0.01,
      "max": 25.4,
      "step": 0.001
    },
    "_comment_profile_geo": "═══ PROFILE GEOMETRY ═══",
    "detectNesting": {
      "type": "checkbox",
      "stage": "geometry",
      "category": "offset",
      "operationTypes": ["profile", "pocket"],
      "default": false
    },
    "cutSide": {
      "type": "select",
      "stage": "geometry",
      "category": "offset",
      "operationTypes": "profile",
      "default": "outside",
      "options": [
        { "value": "outside" },
        { "value": "inside" },
        { "value": "on" }
      ]
    },
    "_comment_pocket_geo": "═══ POCKET GEOMETRY ═══",
    "pocketStrategy": {
      "type": "select",
      "stage": "geometry",
      "category": "offset",
      "operationTypes": "pocket",
      "default": "offset",
      "options": [
        { "value": "offset" }
      ]
    },
    "stepOver": {
      "type": "number",
      "unit": "%",
      "stage": "geometry",
      "category": "offset",
      "operationTypes": "pocket",
      "default": 40,
      "min": 1,
      "max": 95,
      "step": 1
    },
    "rasterAngle": {
      "type": "number",
      "unit": "°",
      "stage": "geometry",
      "category": "offset",
      "operationTypes": "pocket",
      "default": 45,
      "min": 0,
      "max": 180,
      "step": 5,
      "conditional": "pocketStrategy:raster"
    },
    "rasterBidirectional": {
      "type": "checkbox",
      "stage": "geometry",
      "category": "offset",
      "operationTypes": "pocket",
      "default": true,
      "conditional": "pocketStrategy:raster"
    },
    "_comment_drill_geo": "═══ DRILL GEOMETRY ═══",
    "drillMultiTool": {
      "type": "checkbox",
      "stage": "geometry",
      "category": "tool",
      "operationTypes": "drill",
      "default": false
    },
    "millHoles": {
      "type": "checkbox",
      "stage": "geometry",
      "category": "drill",
      "operationTypes": "drill",
      "conditional": "!drillMultiTool",
      "default": true
    },
    "drillStepOver": {
      "type": "number",
      "unit": "%",
      "stage": "geometry",
      "category": "drill",
      "operationTypes": "drill",
      "conditional": "!drillMultiTool && millHoles",
      "default": 50,
      "min": 10,
      "max": 90,
      "step": 5
    },
    "_comment_drill_mill_strat": "═══ DRILL MILLING DEPTH (strategy) ═══",
    "drillMultiDepth": {
      "type": "checkbox",
      "stage": "strategy",
      "category": "depth",
      "operationTypes": "drill",
      "default": true,
      "conditional": "millHoles"
    },
    "drillDepthPerPass": {
      "type": "number",
      "unit": "mm",
      "stage": "strategy",
      "category": "depth",
      "operationTypes": "drill",
      "default": 2,
      "min": 0.1,
      "max": 50,
      "step": 0.5,
      "conditional": "millHoles && drillMultiDepth"
    },
    "drillEntryType": {
      "type": "select",
      "stage": "strategy",
      "category": "depth",
      "operationTypes": "drill",
      "default": "helix",
      "conditional": "millHoles",
      "options": [
        { "value": "helix" },
        { "value": "plunge" }
      ]
    },
    "_comment_engrave_geo": "═══ ENGRAVE GEOMETRY ═══",
    "_comment_vcarve_geo": "═══ V-CARVE GEOMETRY ═══",
    "vbitAngle": {
      "type": "number",
      "unit": "°",
      "stage": "geometry",
      "category": "tool",
      "operationTypes": "vcarve",
      "default": 90,
      "min": 10,
      "max": 150,
      "step": 5
    },
    "vbitTipRadius": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "tool",
      "operationTypes": "vcarve",
      "default": 0,
      "min": 0,
      "max": 5,
      "step": 0.05
    },
    "vcarveStartDepth": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "depth",
      "operationTypes": "vcarve",
      "default": 0,
      "min": 0,
      "max": 20,
      "step": 0.1
    },
    "vcarveMaxDepth": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "depth",
      "operationTypes": "vcarve",
      "default": 0,
      "min": 0,
      "max": 20,
      "step": 0.1
    },
    "vcarveMinChainLength": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "quality",
      "operationTypes": "vcarve",
      "default": 0,
      "min": 0,
      "max": 5,
      "step": 0.1
    },
    "vcarveCornerAngle": {
      "type": "number",
      "unit": "°",
      "stage": "geometry",
      "category": "quality",
      "operationTypes": "vcarve",
      "default": 30,
      "min": 5,
      "max": 90,
      "step": 5
    },
    "vcarveSampleSpacing": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "quality",
      "operationTypes": "vcarve",
      "default": 0.15,
      "min": 0.02,
      "max": 1,
      "step": 0.01
    },
    "vcarveNoiseThreshold": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "quality",
      "operationTypes": "vcarve",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "_comment_relief_geo": "═══ RELIEF GEOMETRY ═══",
    "reliefToolShape": {
      "type": "select",
      "stage": "geometry",
      "category": "tool",
      "operationTypes": "relief",
      "default": "ball",
      "options": [
        { "value": "ball" },
        { "value": "flat" },
        { "value": "bull" }
      ]
    },
    "reliefCornerRadius": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "tool",
      "operationTypes": "relief",
      "conditional": "reliefToolShape:bull",
      "default": 0.5,
      "min": 0,
      "max": 10,
      "step": 0.1
    },
    "reliefDepthMapping": {
      "type": "select",
      "stage": "geometry",
      "category": "depth",
      "operationTypes": "relief",
      "default": "scaled",
      "options": [
        { "value": "scaled" },
        { "value": "literal" }
      ]
    },
    "reliefDepth": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "depth",
      "operationTypes": "relief",
      "default": null,
      "nullable": true,
      "min": 0.1,
      "max": 100,
      "step": 0.1
    },
    "reliefStartDepth": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "depth",
      "operationTypes": "relief",
      "default": 0,
      "min": 0,
      "max": 20,
      "step": 0.1
    },
    "reliefInvert": {
      "type": "checkbox",
      "stage": "geometry",
      "category": "depth",
      "operationTypes": "relief",
      "default": false
    },
    "reliefBoundaryMode": {
      "type": "select",
      "stage": "geometry",
      "category": "bounds",
      "operationTypes": "relief",
      "default": "stop",
      "options": [
        { "value": "stop" },
        { "value": "rollover" },
        { "value": "extend" }
      ]
    },
    "reliefBoundaryMm": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "bounds",
      "operationTypes": "relief",
      "conditional": "reliefBoundaryMode:rollover,extend",
      "default": 0,
      "min": 0,
      "max": 20,
      "step": 0.1
    },
    "reliefMaskUncovered": {
      "type": "checkbox",
      "stage": "geometry",
      "category": "bounds",
      "operationTypes": "relief",
      "default": false
    },
    "reliefMode": {
      "type": "select",
      "stage": "geometry",
      "category": "passes",
      "operationTypes": "relief",
      "default": "finishing",
      "options": [
        { "value": "roughing" },
        { "value": "finishing" },
        { "value": "both" }
      ]
    },
    "reliefRoughStepdown": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "roughing",
      "operationTypes": "relief",
      "conditional": "reliefMode:roughing,both",
      "default": 1.5,
      "min": 0.2,
      "max": 10,
      "step": 0.1
    },
    "reliefRoughStepoverPct": {
      "type": "number",
      "unit": "%",
      "stage": "geometry",
      "category": "roughing",
      "operationTypes": "relief",
      "conditional": "reliefMode:roughing,both",
      "default": 45,
      "min": 10,
      "max": 90,
      "step": 5
    },
    "reliefRoughStock": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "roughing",
      "operationTypes": "relief",
      "conditional": "reliefMode:roughing,both",
      "default": 0.3,
      "min": 0,
      "max": 2,
      "step": 0.05
    },
    "reliefFinishStepoverPct": {
      "type": "number",
      "unit": "%",
      "stage": "geometry",
      "category": "finishing",
      "operationTypes": "relief",
      "conditional": "reliefMode:finishing,both",
      "default": 10,
      "min": 2,
      "max": 50,
      "step": 1
    },
    "reliefRasterAxis": {
      "type": "select",
      "stage": "geometry",
      "category": "finishing",
      "operationTypes": "relief",
      "conditional": "reliefMode:finishing,both",
      "default": "x",
      "options": [
        { "value": "x" },
        { "value": "y" }
      ]
    },
    "reliefCrossFinish": {
      "type": "checkbox",
      "stage": "geometry",
      "category": "finishing",
      "operationTypes": "relief",
      "conditional": "reliefMode:finishing,both",
      "default": false
    },
    "reliefSkipFloor": {
      "type": "checkbox",
      "stage": "geometry",
      "category": "finishing",
      "operationTypes": "relief",
      "conditional": "reliefMode:finishing,both",
      "default": false
    },
    "reliefCellSize": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "quality",
      "operationTypes": "relief",
      "default": null,
      "nullable": true,
      "min": 0.01,
      "max": 1,
      "step": 0.01
    },
    "reliefGridMaxDim": {
      "type": "number",
      "unit": "cells",
      "stage": "geometry",
      "category": "quality",
      "operationTypes": "relief",
      "default": 1024,
      "min": 128,
      "max": 4096,
      "step": 128
    },
    "reliefSimplifyTolerance": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "quality",
      "operationTypes": "relief",
      "conditional": "reliefMode:finishing,both",
      "default": 0.01,
      "min": 0,
      "max": 0.1,
      "step": 0.005
    },
    "reliefMinSegmentLength": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "quality",
      "operationTypes": "relief",
      "conditional": "reliefMode:roughing,both",
      "default": 0.2,
      "min": 0,
      "max": 5,
      "step": 0.1
    },
    "_comment_rotary_geo": "═══ ROTARY / 4TH AXIS (geometry stage) ═══ SPLIT RULE: a key gets its own indexed* entry only when the QUANTITY DIFFERS IN KIND. rotaryRoughStepdown is radius-per-layer; indexedRoughStepdown is Z-per-layer. Everything else stays SHARED on the rotary* key.",
    "rotaryToolShape": {
      "type": "select",
      "stage": "geometry",
      "category": "tool",
      "operationTypes": "rotary",
      "default": "ball",
      "options": [
        { "value": "ball" },
        { "value": "flat" },
        { "value": "bull" }
      ]
    },
    "rotaryCornerRadius": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "tool",
      "operationTypes": "rotary",
      "conditional": "rotaryToolShape:bull",
      "default": 0.5,
      "min": 0,
      "max": 10,
      "step": 0.1
    },
    "indexedCollisionGuard": {
      "type": "checkbox",
      "stage": "geometry",
      "category": "tool",
      "operationTypes": "rotary",
      "conditional": "rotaryKinematics:indexed",
      "disabled": true,
      "default": false
    },
    "rotaryKinematics": {
      "type": "select",
      "stage": "geometry",
      "category": "blank",
      "operationTypes": "rotary",
      "default": "radial",
      "options": [
        { "value": "radial" },
        { "value": "indexed", "requiresCapability": "rotary.indexed" }
      ]
    },
    "rotaryStockShape": {
      "type": "select",
      "stage": "geometry",
      "category": "blank",
      "operationTypes": "rotary",
      "conditional": "rotaryKinematics:radial",
      "default": "round",
      "options": [
        { "value": "round" },
        { "value": "square" }
      ]
    },
    "rotaryBlankDiameter": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "blank",
      "operationTypes": "rotary",
      "conditional": "rotaryKinematics:radial",
      "default": null,
      "nullable": true,
      "min": 0.5,
      "max": 300,
      "step": 0.5
    },
    "indexedFaceCount": {
      "type": "select",
      "stage": "geometry",
      "category": "blank",
      "operationTypes": "rotary",
      "conditional": "rotaryKinematics:indexed",
      "default": "4",
      "options": [
        { "value": "2" },
        { "value": "3" },
        { "value": "4" },
        { "value": "6" },
        { "value": "8" }
      ]
    },
    "indexedStartAngle": {
      "type": "number",
      "unit": "°",
      "stage": "geometry",
      "category": "blank",
      "operationTypes": "rotary",
      "conditional": "rotaryKinematics:indexed",
      "default": 0,
      "min": -360,
      "max": 360,
      "step": 15
    },
    "indexedBlankWidth": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "blank",
      "operationTypes": "rotary",
      "conditional": "rotaryKinematics:indexed",
      "default": null,
      "nullable": true,
      "min": 0.5,
      "max": 300,
      "step": 0.5
    },
    "rotaryDepth": {
      "type": "number",
      "unit": "mm",
      "stage": "geometry",
      "category": "depth",
      "operationTypes": "rotary",
      "conditional": "rotaryKinematics:radial",
      "default": null,
      "nullable": true,
      "min": 0.1,
