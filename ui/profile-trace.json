{
  "_projectInfo": {
    "file": "ui/profile-trace.json",
    "description": "EasyTrace5000 profile",
    "author": "Eltryus - Ricardo Marques",
    "see": "https://github.com/RicardoJCMarques/EasyCAM5000",
    "license": "AGPL-3.0-or-later",
    "copyright": "Copyright (C) 2025-2026 Eltryus - Ricardo Marques"
  },
  "meta": {
    "app": "EasyTrace5000",
    "version": "1.2"
  },
  "clipper2scale": 10000,
  "chains": {
    "2d": {
      "stages": ["geometry", "output"],
      "artifacts": ["offsets"]
    },
    "2.5d": {
      "stages": ["geometry", "strategy", "machine", "output"],
      "artifacts": ["offsets", "preview", "toolpath"]
    }
  },
  "operations": {
    "isolation": {
      "handler": "TraceIsolationHandler",
      "toolSizing": "effective",
      "extensions": [".gbr", ".ger", ".gtl", ".gbl", ".gbx", ".svg"],
      "defaultTool": "vbit_45deg_0.2mm",
      "machineClasses": { "router": "2.5d", "laser": "2d" }
    },
    "clearing": {
      "handler": "TraceClearingHandler",
      "toolSizing": "effective",
      "extensions": [".gbr", ".ger", ".gtl", ".gbl", ".gbx", ".svg"],
      "defaultTool": "em_0.8mm_flat",
      "machineClasses": { "router": "2.5d", "laser": "2d" }
    },
    "drill": {
      "handler": "DrillHandler",
      "extensions": [".drl", ".xln", ".txt", ".tap", ".drill", ".exc", ".svg"],
      "defaultTool": "em_1.0mm_flat",
      "machineClasses": { "router": "2.5d", "laser": "2d" },
      "defaults": { "laserCutSide": "inside" },
      "cutsThrough": true
    },
    "cutout": {
      "handler": "TraceCutoutHandler",
      "extensions": [".gbr", ".ger", ".gko", ".gml", ".gm1", ".svg"],
      "defaultTool": "em_1.0mm_flat",
      "machineClasses": { "router": "2.5d", "laser": "2d" },
      "defaults": { "depthPerPass": 0.3 },
      "cutsThrough": true
    },
    "stencil": {
      "handler": "TraceStencilHandler",
      "extensions": [".gbr", ".ger", ".gtp", ".gbp", ".gts", ".gbs", ".svg"],
      "defaultTool": "em_0.5mm_flat",
      "machineClasses": { "router": "2.5d", "knife": "2d" }
    }
  },
  "examples": {
    "exampleSMD1": {
      "files": {
        "isolation": "../examples/exampleSMD1/isolation.gbr",
        "drill": "../examples/exampleSMD1/drill.drl",
        "clearing": "../examples/exampleSMD1/clearing.gbr",
        "cutout": "../examples/exampleSMD1/cutout.gbr",
        "stencil": "../examples/exampleSMD1/stencil.gbr"
      }
    },
    "exampleThroughHole1": {
      "files": {
        "isolation": "../examples/exampleThroughHole1/Gerber_BottomLayer.gbl",
        "drill": "../examples/exampleThroughHole1/Excellon_PTH_Through.drl",
        "cutout": "../examples/exampleThroughHole1/Gerber_BoardOutlineLayer.gko"
      }
    },
    "line": {
      "files": { "isolation": "../examples/LineTest.svg" }
    },
    "calibration": {
      "files": { "cutout": "../examples/100mmSquare.svg" }
    }
  },
  "ui": {
    "exportOrder": ["isolation", "clearing", "drill", "cutout", "stencil"],
    "categories": [
      "post",
      "stock",
      "heights",
      "rotary",
      "laser",
      "stencil",
      "tool",
      "offset",
      "laser_geometry",
      "laser_strategy",
      "laser_cutout",
      "strategy",
      "depth",
      "cutout",
      "drill",
      "feeds",
      "toolpath",
      "machine",
      "laser_export",
      "general"
    ],
    "artifacts": {
      "offsets": { "icon": "icon-stage-offsets" },
      "preview": { "icon": "icon-stage-preview" },
      "toolpath": { "icon": "icon-toolpath-stage" }
    },
    "shortcuts": [
      { "combo": "1", "action": "cycleCategory", "args": ["isolation"] },
      { "combo": "2", "action": "cycleCategory", "args": ["drill"] },
      { "combo": "3", "action": "cycleCategory", "args": ["clearing"] },
      { "combo": "4", "action": "cycleCategory", "args": ["stencil"] },
      { "combo": "5", "action": "cycleCategory", "args": ["cutout"] }
    ]
  },
  "machineParameters": {
    "machine.stock.width": null,
    "machine.stock.length": null,
    "machine.stock.margin": null,
    "machine.stock.material": null,
    "machine.stock.zeroReference": null,
    "gcode.absoluteZ": null,
    "machine.view.rotaryGrid": null,
    "machine.view.rotaryWorkholding": null,
    "machine.stock.thicknessCopper": { "default": 0.035 }
  },
  "parameters": {
    "drillMultiTool": {
      "type": "checkbox",
      "stage": "geometry",
      "category": "tool",
      "operationTypes": "drill",
      "default": false
    },
    "tool": {
      "type": "select",
      "stage": "geometry",
      "category": "tool",
      "conditional": "!drillMultiTool",
      "operationTypes": ["isolation", "clearing", "cutout", "drill", "stencil"]
    },
    "toolNumber": {
      "type": "number",
      "stage": "geometry",
      "category": "tool",
      "default": 1,
      "min": 1,
      "max": 99,
      "step": 1,
      "invalidates": false,
      "conditional": "!drillMultiTool",
      "operationTypes": ["isolation", "clearing", "cutout", "drill", "stencil"]
    },
    "toolDiameter": {
      "type": "number",
      "unit": "mm",
      "min": 0.01,
      "max": 10.0,
      "step": 0.001,
      "stage": "geometry",
      "category": "tool",
      "conditional": "!drillMultiTool",
      "operationTypes": ["isolation", "clearing", "cutout", "drill", "stencil"]
    },
    "passes": {
      "type": "number",
      "min": 1,
      "max": 30,
      "step": 1,
      "stage": "geometry",
      "category": "offset",
      "operationTypes": ["isolation"],
      "default": 3
    },
    "stepOver": {
      "type": "number",
      "unit": "%",
      "min": 10,
      "max": 99,
      "step": 5,
      "stage": "geometry",
      "category": "offset",
      "operationTypes": ["isolation", "clearing"],
      "default": 50
    },
    "combineOffsets": {
      "type": "checkbox",
      "default": true,
      "stage": "geometry",
      "category": "offset",
      "operationTypes": ["isolation"]
    },
    "cutSide": {
      "type": "select",
      "default": "outside",
      "stage": "geometry",
      "category": "cutout",
      "operationTypes": "cutout",
      "options": [
        { "value": "outside" },
        { "value": "inside" },
        { "value": "on" }
      ]
    },
    "cutDepth": {
      "type": "number",
      "unit": "mm",
      "min": -10,
      "max": 0,
      "step": 0.001,
      "default": -0.1,
      "throughFrom": "machine.stock.thickness",
      "negate": true,
      "stage": "strategy",
      "category": "depth",
      "operationTypes": ["isolation", "clearing", "cutout", "drill", "stencil"]
    },
    "multiDepth": {
      "type": "checkbox",
      "default": true,
      "stage": "strategy",
      "category": "depth",
      "operationTypes": ["isolation", "clearing", "cutout", "stencil"]
    },
    "depthPerPass": {
      "type": "number",
      "unit": "mm",
      "min": 0.001,
      "max": 5,
      "step": 0.001,
      "default": 0.1,
      "stage": "strategy",
      "category": "depth",
      "operationTypes": ["isolation", "clearing", "cutout", "stencil"],
      "conditional": "multiDepth"
    },
    "entryType": {
      "type": "select",
      "stage": "strategy",
      "category": "strategy",
      "default": "plunge",
      "operationTypes": ["isolation", "clearing", "cutout", "stencil"],
      "options": [
        { "value": "plunge" }
      ]
    },
    "_comment_drill_geo": "═══ DRILL GEOMETRY ═══",
    "millHoles": {
      "type": "checkbox",
      "stage": "geometry",
      "category": "drill",
      "operationTypes": "drill",
      "default": true,
      "conditional": "!drillMultiTool"
    },
    "drillStepOver": {
      "type": "number",
      "unit": "%",
      "stage": "geometry",
      "category": "drill",
      "operationTypes": "drill",
      "default": 50,
      "min": 10,
      "max": 90,
      "step": 5,
      "conditional": "!drillMultiTool && millHoles"
    },
    "_comment_drill_mill_strat": "═══ DRILL MILLING DEPTH (strategy, conditional on millHoles) ═══",
    "drillMultiDepth": {
      "type": "checkbox",
      "stage": "strategy",
      "category": "depth",
      "operationTypes": "drill",
      "default": true,
      "conditional": "millHoles"
    },
    "drillDepthPerPass": {
      "type": "number",
      "unit": "mm",
      "stage": "strategy",
      "category": "depth",
      "operationTypes": "drill",
      "default": 0.5,
      "min": 0.01,
      "max": 10.0,
      "step": 0.05,
      "conditional": "millHoles && drillMultiDepth"
    },
    "drillEntryType": {
      "type": "select",
      "stage": "strategy",
      "category": "depth",
      "operationTypes": "drill",
      "default": "helix",
      "conditional": "millHoles",
      "options": [
        { "value": "helix" },
        { "value": "plunge" }
      ]
    },
    "peckDepth": {
      "type": "number",
      "unit": "mm",
      "min": 0,
      "max": 5,
      "step": 0.01,
      "stage": "strategy",
      "category": "drill",
      "operationTypes": "drill",
      "default": 0
    },
    "dwellTime": {
      "type": "number",
      "unit": "s",
      "min": 0,
      "max": 10,
      "step": 0.1,
      "stage": "strategy",
      "category": "drill",
      "operationTypes": "drill",
      "default": 0
    },
    "retractHeight": {
      "type": "number",
      "unit": "mm",
      "min": 0,
      "max": 10,
      "step": 0.01,
      "stage": "strategy",
      "category": "drill",
      "operationTypes": "drill",
      "default": 0.5
    },
    "cannedCycle": {
      "type": "select",
      "stage": "strategy",
      "category": "drill",
      "operationTypes": "drill",
      "default": "none",
      "options": [
        { "value": "none" },
        { "value": "G81" },
        { "value": "G82" },
        { "value": "G83" },
        { "value": "G73" }
      ]
    },
    "tabs": {
      "type": "number",
      "min": 0,
      "max": 12,
      "step": 1,
      "stage": "strategy",
      "category": "cutout",
      "operationTypes": "cutout",
      "default": 0
    },
    "tabWidth": {
      "type": "number",
      "unit": "mm",
      "min": 0.1,
      "max": 10,
      "step": 0.1,
      "stage": "strategy",
      "category": "cutout",
      "operationTypes": "cutout",
      "default": 0.5
    },
    "tabHeight": {
      "type": "number",
      "unit": "mm",
      "min": 0.1,
      "max": 5,
      "step": 0.1,
      "stage": "strategy",
      "category": "cutout",
      "operationTypes": "cutout",
      "default": 0.5
    },
    "feedRate": {
      "type": "number",
      "unit": "mm/min",
      "min": 1,
      "max": 5000,
      "step": 1,
      "stage": "machine",
      "category": "feeds"
    },
    "plungeRate": {
      "type": "number",
      "unit": "mm/min",
      "min": 1,
      "max": 2000,
      "step": 1,
      "stage": "machine",
      "category": "feeds"
    },
    "spindleSpeed": {
      "type": "number",
      "unit": "RPM",
      "min": 100,
      "max": 30000,
      "default": 10000,
      "step": 1,
      "stage": "machine",
      "category": "feeds"
    },
    "spindleDwell": {
      "type": "number",
      "unit": "s",
      "min": 0,
      "max": 60,
      "step": 0.5,
      "default": 1,
      "stage": "machine",
      "category": "feeds"
    },
    "laserIsolationWidth": {
      "type": "number",
      "unit": "mm",
      "step": 0.01,
      "min": 0.05,
      "max": 2.5,
      "default": 0.3,
      "stage": "geometry",
      "category": "laser_geometry",
      "machineClasses": ["laser"],
      "operationTypes": "isolation"
    },
    "laserClearingPadding": {
      "type": "number",
      "unit": "mm",
      "step": 0.1,
      "min": 0,
      "max": 10.0,
      "default": 1.0,
      "stage": "geometry",
      "category": "laser_geometry",
      "machineClasses": ["laser"],
      "operationTypes": "clearing"
    },
    "laserClearStrategy": {
      "type": "select",
      "default": "filled",
      "stage": "geometry",
      "category": "laser_strategy",
      "machineClasses": ["laser"],
      "operationTypes": ["isolation", "clearing"],
      "options": [
        { "value": "filled" },
        { "value": "offset" },
        { "value": "hatch" }
      ]
    },
    "laserSpotSize": {
      "type": "number",
      "unit": "mm",
      "step": 0.01,
      "min": 0.01,
      "max": 1.0,
      "stage": "geometry",
      "category": "laser_strategy",
      "machineClasses": ["laser"],
      "operationTypes": ["isolation", "clearing"],
      "conditional": "laserClearStrategy:offset,hatch",
      "readOnly": true
    },
    "laserSpacingMode": {
      "type": "select",
      "default": "stepover",
      "stage": "geometry",
      "category": "laser_strategy",
      "machineClasses": ["laser"],
      "operationTypes": ["isolation", "clearing"],
      "conditional": "laserClearStrategy:offset,hatch",
      "options": [
        { "value": "stepover" },
        { "value": "lpcm" },
        { "value": "lpi" }
      ]
    },
    "laserStepOver": {
      "type": "number",
      "unit": "%",
      "step": 5,
      "min": 10,
      "max": 99,
      "default": 50,
      "stage": "geometry",
      "category": "laser_strategy",
      "machineClasses": ["laser"],
      "operationTypes": ["isolation", "clearing"],
      "conditional": "laserClearStrategy:offset,hatch&&laserSpacingMode:stepover"
    },
    "laserLinesPerCm": {
      "type": "number",
      "unit": "lines/cm",
      "step": 1,
      "min": 1,
      "max": 1000,
      "default": 200,
      "stage": "geometry",
      "category": "laser_strategy",
      "machineClasses": ["laser"],
      "operationTypes": ["isolation", "clearing"],
      "conditional": "laserClearStrategy:offset,hatch&&laserSpacingMode:lpcm"
    },
    "laserLinesPerInch": {
      "type": "number",
      "unit": "lines/inch",
      "step": 5,
      "min": 5,
      "max": 2540,
      "default": 508,
      "stage": "geometry",
      "category": "laser_strategy",
      "machineClasses": ["laser"],
      "operationTypes": ["isolation", "clearing"],
      "conditional": "laserClearStrategy:offset,hatch&&laserSpacingMode:lpi"
    },
    "laserHatchPasses": {
      "type": "number",
      "step": 1,
      "min": 1,
      "max": 8,
      "default": 2,
      "stage": "geometry",
      "category": "laser_strategy",
      "machineClasses": ["laser"],
      "operationTypes": ["isolation", "clearing"],
      "conditional": "laserClearStrategy:hatch"
    },
    "laserHatchAngle": {
      "type": "number",
      "unit": "°",
      "step": 5,
      "min": 0,
      "max": 180,
      "default": 45,
      "stage": "geometry",
      "category": "laser_strategy",
      "machineClasses": ["laser"],
      "operationTypes": ["isolation", "clearing"],
      "conditional": "laserClearStrategy:hatch"
    },
    "laserCutSide": {
      "type": "select",
      "default": "outside",
      "stage": "geometry",
      "category": "laser_cutout",
      "machineClasses": ["laser"],
      "operationTypes": ["cutout", "drill"],
      "options": [
        { "value": "outside" },
        { "value": "inside" },
        { "value": "on" }
      ]
    },
    "stencilMachine": {
      "type": "select",
      "stage": "geometry",
      "category": "stencil",
      "operationTypes": ["stencil"],
      "machineClasses": ["router", "knife"],
      "bindsMachineClass": true,
      "default": "router",
      "options": [
        { "value": "router" },
        { "value": "knife" }
      ]
    },
    "stencilOffset": {
      "type": "number",
      "unit": "mm",
      "step": 0.01,
      "min": -1.0,
      "max": 1.0,
      "default": -0.05,
      "stage": "geometry",
      "category": "stencil",
      "operationTypes": "stencil",
      "machineClasses": ["router", "laser", "knife"]
    },
    "stencilIgnoreRegions": {
      "type": "checkbox",
      "default": true,
      "stage": "geometry",
      "category": "stencil",
      "operationTypes": "stencil",
      "machineClasses": ["router", "laser", "knife"]
    },
    "stencilExcludeDrillPads": {
      "type": "checkbox",
      "default": true,
      "stage": "geometry",
      "category": "stencil",
      "operationTypes": "stencil",
      "machineClasses": ["router", "laser", "knife"]
    },
    "stencilAddRegHoles": {
      "type": "checkbox",
      "default": false,
      "stage": "geometry",
      "category": "stencil",
      "operationTypes": "stencil",
      "machineClasses": ["router", "laser", "knife"]
    },
    "stencilRegDiameter": {
      "type": "number",
      "unit": "mm",
      "step": 0.1,
      "min": 0.5,
      "max": 10.0,
      "default": 3.0,
      "stage": "geometry",
      "category": "stencil",
      "operationTypes": "stencil",
      "conditional": "stencilAddRegHoles",
      "machineClasses": ["router", "laser", "knife"]
    },
    "stencilRegMargin": {
      "type": "number",
      "unit": "mm",
      "step": 0.5,
      "min": 1.0,
      "max": 25.0,
      "default": 5.0,
      "stage": "geometry",
      "category": "stencil",
      "operationTypes": "stencil",
      "conditional": "stencilAddRegHoles",
      "machineClasses": ["router", "laser", "knife"]
    },
    "stencilCornerRadius": {
      "type": "number",
      "unit": "mm",
      "step": 0.01,
      "min": 0,
      "max": 2,
      "default": 0,
      "stage": "geometry",
      "category": "stencil",
      "operationTypes": "stencil",
      "machineClasses": ["knife"]
    },
    "optimizeToolpath": {
      "type": "checkbox",
      "default": true,
      "stage": "machine",
      "category": "toolpath",
      "machineClasses": ["router"],
      "invalidates": false
    }
  }
}