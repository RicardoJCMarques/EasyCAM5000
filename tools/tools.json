  "_schema": {
    "meta": "kind is toolLibrary: read only when the file is added as a custom library, which replaces this one (tools/README.md).",
    "id": "Unique in the library and never changed once shipped: profiles (defaultTool) and saved operations refer to tools by id.",
    "type": "flat | ball | bull | corn | drill | vbit | taperedBall. Decides the required geometry and the generated name (tools.names.<type> in the language pack).",
    "name": "Optional. Shown exactly as written, in every language, instead of the generated name.",
    "geometry": "Millimeters and degrees. Always: diameter, the widest cutting diameter. bull: cornerRadius. vbit: tipDiameter and angle (included). taperedBall: tipDiameter and halfAngle (per side).",
    "geometryOptional": "effectiveDiameter (vbit and taperedBall: the width cut at engraving depth; defaults to tipDiameter), flutes, pointAngle, cuttingLength, shankDiameter, totalLength. holderDiameter and holderStickout go together, need shankDiameter and cuttingLength, and enable the indexed collision guard.",
    "cutting": "Required: feedRate and plungeRate (mm/min), spindleSpeed (RPM). Optional: maxDepthPerPass (mm), stepOver (%), peckDepth (mm), spindleDwell (s), dwellTime (s, reserved: not read yet).",
    "operations": "Operation types whose tool list includes this tool. May be empty.",
    "toolNumber": "Optional changer slot: a positive integer, unique in the library."
  },
